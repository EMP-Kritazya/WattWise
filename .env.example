# Load in each backend/agents terminal: set -a; source .env; set +a
# Never commit .env or real credentials.
KITCHEN_IMPL=real
HUB_IMPL=browser
LIVE_TRANSPORT=ws
STORE=memory
HARDWARE=off
DEMO_MODE=1
SIM_START_TS=2026-07-18T00:30:00Z
AGENT_TOKEN=replace-with-a-shared-local-secret
FETCH_AGENT_SEED=replace-with-a-long-private-agent-seed
API_URL=http://127.0.0.1:8000
CONTEXT_INTERVAL_S=600
# Fetch agents use Agentverse mailboxes; connect all four agents via inspector.
AGENT_MAILBOX=1
# Optional AI: engine decisions and safe escalation fallbacks work without keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ASI1_API_KEY=
ASI1_MODEL=
# Real seconds Claude waits for fresh Fetch context before choosing; 0 when the agents are not running (at 120x an
# escalation's deadline is only 2.5-5 real seconds, so a 5 s wait means Claude misses every one).
COUNCIL_WAIT_S=5
# Proof: real seconds per replayed month, and whether to fill the year cache at startup.
REPLAY_MONTH_S=5
BACKTEST_PRECOMPUTE=1
# Live events public chat only; typed engine event context currently stays recorded.
TICKETMASTER_API_KEY=
# Optional hosted live tables: set LIVE_TRANSPORT=spacetime and frontend values below.
SPACETIMEDB_URL=http://localhost:3000
SPACETIMEDB_DB=wattwise
SPACETIMEDB_TOKEN=
# Optional durable store: set STORE=convex.
CONVEX_URL=
# Copy these frontend settings to frontend/.env.local (Vite reads that file).
VITE_MOCKS=0
VITE_LIVE_TRANSPORT=ws
VITE_SPACETIME_URI=ws://localhost:3000
VITE_SPACETIME_DB=wattwise
VITE_SPACETIME_TOKEN=

# Real billed amounts require the PG&E URDB dataset described in docs/design/DATA_AND_PROOF.md.
# VITE_TARIFF_ID=pge_b19_secondary_voluntary
